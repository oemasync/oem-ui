---
/**
 * oem-ui <Sparkline> — one series, no axes.
 *
 * The component answers a single question: is this number going up or
 * down. It is a CHART with the axes, grid, legend and tooltip removed,
 * because the cell it lives in has room for a shape and nothing else.
 *
 * The points arrive in the markup. There is no runtime here: a table
 * with a hundred sparklines would otherwise carry a hundred charts'
 * worth of script for a shape that is fully determined by its input.
 *
 * The scale is computed here, not in CSS, because the SVG's own
 * coordinate system is the only thing that can place a point between
 * two samples. CSS cannot do it, and a library that pretended
 * otherwise would ship a sparkline whose y-axis is decorative.
 */
interface Props {
	/** The series, oldest first. */
	values: number[];
	/** Accessible name. The shape is meaningless without it. */
	label?: string;
	/** 'line' is the default; 'area' fills under the line. */
	variant?: 'line' | 'area';
	/** 'dim' recedes, 'muted' recedes further. */
	tone?: 'normal' | 'dim' | 'muted';
	/** Drawing width in user units. The SVG scales to its box. */
	width?: number;
	/** Drawing height in user units. */
	height?: number;
	/** Mark the last sample. */
	showDot?: boolean;
}

const {
	values,
	label,
	variant = 'line',
	tone = 'normal',
	width = 100,
	height = 32,
	showDot = true,
} = Astro.props;

// A series that is empty, or holds nothing but non-finite numbers, has
// no shape. Rendering an empty SVG with a zero-height path would draw a
// flat line across the cell and read as "steady", which is a claim the
// data does not make.
const finite = (values ?? []).filter((v) => typeof v === 'number' && Number.isFinite(v));
const hasData = finite.length > 0;

const min = hasData ? Math.min(...finite) : 0;
const max = hasData ? Math.max(...finite) : 0;
// A flat series would divide by zero. Give it one unit of headroom so
// the line lands in the middle of the box instead of on its edge.
const span = max - min || 1;
const pad = 2; // user units of breathing room above and below the line

const points = finite.map((v, i) => {
	const x = finite.length === 1 ? width / 2 : (i / (finite.length - 1)) * width;
	const y = height - pad - ((v - min) / span) * (height - pad * 2);
	return { x, y };
});

const line = points.map((p) => `${p.x.toFixed(2)},${p.y.toFixed(2)}`).join(' ');
const area = points.length
	? `0,${height} ${line} ${width},${height}`
	: '';

const last = points[points.length - 1];
const cls = ['cm-spark'];
if (tone !== 'normal') cls.push(`cm-spark--${tone}`);
if (!hasData) cls.push('cm-spark--empty');
---

{
	hasData ? (
		<span class:list={cls}>
			<svg
				class="cm-spark__svg"
				viewBox={`0 0 ${width} ${height}`}
				preserveAspectRatio="none"
				role="img"
				aria-label={label ?? 'sparkline'}
			>
				{variant === 'area' && <polygon class="cm-spark__area" points={area} />}
				<polyline class="cm-spark__line" points={line} />
				{showDot && last && <circle class="cm-spark__dot" cx={last.x} cy={last.y} r={1.6} />}
			</svg>
		</span>
	) : (
		<span class:list={[...cls, 'cm-spark--empty']} aria-label={label ?? 'no data'}>
			<span class="cm-spark__label">no data</span>
		</span>
	)
}
