---
/**
 * oem-ui <Project> — one card in a `.cm-projects` grid.
 *
 * The whole surface is the link: name + a right-aligned period, a blurb,
 * an optional note under a dashed rule, and the stack pinned to the bottom.
 * A consumer used to hand-type this on every index page; the em dash before
 * the blurb is generated by `::before`, so passing a blurb can never produce
 * a doubled one.
 *
 * A reserved slot sets `pending`: it is a `<div>`, not an `<a>`, so it has no
 * hover state and no tab stop — there is nothing to go to.
 */
interface Props {
	/** Link target. Omit when `pending` is set. */
	href?: string;
	/** Project name. A reserved slot defaults to a single em dash. */
	name?: string;
	/** Right-aligned label on the top row, e.g. a year span. */
	period?: string;
	/** One-line description; the leading em dash is CSS, not this prop. */
	blurb?: string;
	/** Optional note, set off by a dashed rule. */
	note?: string;
	/** Stack tags, pinned to the bottom of the card. */
	stack?: string[];
	/** Render the reserved slot: a dashed, non-link `<div>`. */
	pending?: boolean;
}

const { href, name, period, blurb, note, stack, pending = false } = Astro.props;
---

{
	pending ? (
		<li>
			<div class="cm-project cm-project--pending" aria-hidden="true">
				<span class="cm-project__top">
					<span class="cm-project__name">{name ?? '—'}</span>
				</span>
				{blurb && <span class="cm-project__blurb">{blurb}</span>}
			</div>
		</li>
	) : (
		<li>
			<a class="cm-project" href={href}>
				<span class="cm-project__top">
					<span class="cm-project__name">{name}</span>
					{period && <span class="cm-project__period">{period}</span>}
				</span>
				{blurb && <span class="cm-project__blurb">{blurb}</span>}
				{note && <span class="cm-project__note">{note}</span>}
				{stack && stack.length > 0 && (
					<span class="cm-project__stack">
						{stack.map((s) => (
							<span class="cm-tag">{s}</span>
						))}
					</span>
				)}
			</a>
		</li>
	)
}
